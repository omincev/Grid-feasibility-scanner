# Grid Opportunity Scanner server settings: /etc/grid-scanner/env, mode 600, owner deploy.
# Written by infra/bootstrap.sh from infra/server-env.template (__GENERATE__ becomes a random hex secret,
# __SSLIP__ the server's <ip-with-dashes>.sslip.io name); later runs only add missing names.
# Read by docker compose for interpolation (infra/docker-compose.prod.yml) and by the deploy, backup and
# restore-check scripts. Never commit it or copy it off the server. infra/README.md, "VPS", explains each name.

# Public HTTPS (Caddy, Let's Encrypt): a DNS name with an A record for this server.
DOMAIN=__SSLIP__
# Browser origins allowed to call the API, comma-separated (the Lovable app's URLs). Empty: any origin.
CORS_ALLOWED_ORIGINS=

# Dagster UI at https://dagster.<DOMAIN>/ behind basic auth; alert links point there. DAGSTER_UI_HOST: a host name
# (no https://) to use instead, empty for that default; with your own DOMAIN it needs a DNS record. Empty hash: the
# site is locked for everyone. Make a hash with `docker run -it --rm caddy:2.10.2-alpine caddy hash-password`
# (prompts twice) and paste it in SINGLE quotes, as it contains `$`: DAGSTER_UI_HASH='$2a$14$...'. Use a long
# random password, then run `deploy <current sha>`.
DAGSTER_UI_HOST=
DAGSTER_UI_USER=operator
DAGSTER_UI_HASH=

# PostgreSQL superuser `scanner` and PostgREST's login role `authenticator`.
POSTGRES_PASSWORD=__GENERATE__
AUTHENTICATOR_PASSWORD=__GENERATE__

# Raw-data API: PostgREST accepts bearer tokens signed with this secret (at least 32 characters) for the
# `authenticated` views; mint one with `scanner token --days N`. Changing it revokes every token (then deploy).
API_JWT_SECRET=__GENERATE__
# Most rows one API request returns (PostgREST max-rows); clients page with limit and offset.
API_MAX_ROWS=50000

# Raw store: MinIO on this server; bucket and key are created by the minio-init service. For Cloudflare R2,
# change RAW_STORE_URL, FSSPEC_S3_ENDPOINT_URL, AWS_* and AWS_DEFAULT_REGION=auto (infra/README.md).
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=__GENERATE__
RAW_STORE_URL=s3://raw/grid-scanner
FSSPEC_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=scanner-raw
AWS_SECRET_ACCESS_KEY=__GENERATE__

# Sources. ENTSOE_API_TOKEN is required by the ENTSO-E ingests.
ENTSOE_API_TOKEN=
USER_AGENT=grid-scanner/0.1 (+contact: set an e-mail address here)
# true while owner-approved assumption values are null; outputs computed from proposed values say so.
SCANNER_ALLOW_PROPOSED_ASSUMPTIONS=true
# Only for rebuilding geometries (scripts/build_geometries.py); not needed to run the platform.
DATAFORDELER_API_KEY=

# Alerts, off when empty: an ntfy topic URL, a Slack incoming webhook, or any URL that takes a POST.
ALERT_WEBHOOK_URL=
DISK_ALERT_PERCENT=85

# Backups (systemd timers): dumps kept on this server, and an optional off-site copy:
# rclone:<remote>:<path> (config /etc/grid-scanner/rclone.conf) or an fsspec URL with
# BACKUP_OFFSITE_OPTIONS='{"endpoint_url": "...", "key": "...", "secret": "..."}'.
BACKUP_KEEP=14
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_OPTIONS=

# Layout and image; change only for a rehearsal.
DATA_DIR=/var/lib/grid-scanner
IMAGE=ghcr.io/omincev/grid-feasibility-scanner
